[
  {
    "text": "Guten Tag.",
    "start": 0.65,
    "speech_end": 2.275,
    "end": 2.555
  },
  {
    "text": "Ich möchte mich kurz vorstellen.",
    "start": 2.555,
    "speech_end": 5.315,
    "end": 5.595000000000001
  },
  {
    "text": "Ich heiße Angela und bin 38 Jahre alt.",
    "start": 5.595000000000001,
    "speech_end": 9.965,
    "end": 10.245000000000001
  },
  {
    "text": "Ich komme aus Kolumbien und lebe seit vier Jahren in Deutschland.",
    "start": 10.245000000000001,
    "speech_end": 15.065,
    "end": 15.345
  },
  {
    "text": "Ich wohne in Berlin.",
    "start": 15.345,
    "speech_end": 17.404999999999998,
    "end": 17.955
  },
  {
    "text": "Ich bin verheiratet und habe eine kleine Tochter.",
    "start": 17.955,
    "speech_end": 21.97,
    "end": 22.25
  },
  {
    "text": "Sie heißt Antonella.",
    "start": 22.25,
    "speech_end": 24.419999999999998,
    "end": 24.97
  },
  {
    "text": "Ich bin Rechtsanwältin von Beruf.",
    "start": 24.97,
    "speech_end": 28.04,
    "end": 28.32
  },
  {
    "text": "In Kolumbien habe ich als Rechtsanwältin gearbeitet.",
    "start": 28.32,
    "speech_end": 32.699999999999996,
    "end": 32.98
  },
  {
    "text": "Ich habe dort viele Jahre Berufserfahrung gesammelt.",
    "start": 32.98,
    "speech_end": 37.125,
    "end": 37.675
  },
  {
    "text": "Zurzeit lerne ich Deutsch, weil ich in Deutschland leben und arbeiten möchte.",
    "start": 37.675,
    "speech_end": 43.625,
    "end": 43.905
  },
  {
    "text": "Deutsch ist für mich sehr wichtig, deshalb möchte ich meine Deutschkenntnisse weiter verbessern.",
    "start": 43.905,
    "speech_end": 50.535,
    "end": 51.085
  },
  {
    "text": "In meiner Freizeit verbringe ich gerne Zeit mit meiner Familie.",
    "start": 51.085,
    "speech_end": 55.805,
    "end": 56.085
  },
  {
    "text": "Ich reise gerne und interessiere mich für andere Kulturen.",
    "start": 56.085,
    "speech_end": 60.65,
    "end": 61.199999999999996
  },
  {
    "text": "In Zukunft möchte ich mein Deutsch weiter verbessern und wieder als Rechtsanwältin arbeiten.",
    "start": 61.199999999999996,
    "speech_end": 67.61500000000001,
    "end": 68.165
  },
  {
    "text": "Vielen Dank.",
    "start": 68.165,
    "speech_end": 69.84,
    "end": 71.16666666666667
  }
]