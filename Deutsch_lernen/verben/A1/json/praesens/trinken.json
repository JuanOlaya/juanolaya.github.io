    "praesens_examples": {
        "ich": {
            "de": "Ich trinke Wasser.",
            "en": "I drink water.",
            "es": "Yo bebo agua."
        },
        "du": {
            "de": "Trinkst du Kaffee oder Tee?",
            "en": "Do you drink coffee or tea?",
            "es": "¿Bebes café o té?"
        },
        "er": {
            "de": "Er trinkt gern Bier.",
            "en": "He likes to drink beer.",
            "es": "A él le gusta beber cerveza."
        },
        "sie": {
            "de": "Sie trinkt jeden Morgen Orangensaft.",
            "en": "She drinks orange juice every morning.",
            "es": "Ella bebe jugo de naranja cada mañana."
        },
        "es": {
            "de": "Das Baby trinkt Milch.",
            "en": "The baby drinks milk.",
            "es": "El bebé bebe leche."
        },
        "wir": {
            "de": "Wir trinken einen Wein.",
            "en": "We drink a wine.",
            "es": "Nosotros bebemos un vino."
        },
        "ihr": {
            "de": "Trinkt ihr etwas?",
            "en": "Are you drinking something?",
            "es": "¿Bebéis algo?"
        },
        "sie (plural)": {
            "de": "Sie trinken kalte Limonade.",
            "en": "They drink cold lemonade.",
            "es": "Ellos beben limonada fría."
        },
        "Sie (formal)": {
            "de": "Was trinken Sie, bitte?",
