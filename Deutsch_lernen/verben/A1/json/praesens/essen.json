{
    "vokalwechsel": "e > i (du isst, er/sie/es isst)",
    "praesens": {
        "ich": "esse",
        "du": "isst",
        "wir": "essen",
        "ihr": "esst",
        "er": "isst",
        "sie": "isst",
        "es": "isst",
        "sie (plural)": "essen",
        "Sie (formal)": "essen"
    },
    "praesens_examples": {
        "ich": {
            "de": "Ich esse einen Apfel.",
            "en": "I eat an apple.",
            "es": "Yo como una manzana."
        },
        "du": {
            "de": "Isst du gern Pizza?",
            "en": "Do you like to eat pizza?",
            "es": "¿Te gusta comer pizza?"
        },
        "er": {
            "de": "Er isst jeden Tag Brot.",
            "en": "He eats bread every day.",
            "es": "Él come pan todos los días."
        },
        "sie": {
            "de": "Sie isst immer Salat.",
            "en": "She always eats salad.",
            "es": "Ella siempre come ensalada."
        },
        "es": {
            "de": "Das Kind isst Schokolade.",
            "en": "The child eats chocolate.",
            "es": "El niño come chocolate."
        },
        "wir": {
            "de": "Wir essen zusammen.",
            "en": "We eat together.",
            "es": "Nosotros comemos juntos."
        },
        "ihr": {
            "de": "Esst ihr zu Hause?",
            "en": "Do you eat at home?",
            "es": "¿Coméis en casa?"
        },
        "sie (plural)": {
            "de": "Sie essen im Restaurant.",
            "en": "They eat in the restaurant.",
            "es": "Ellos comen en el restaurante."
        },
        "Sie (formal)": {
            "de": "Was essen Sie gern?",
            "en": "What do you like to eat?",
            "es": "¿Qué le gusta comer?"
        }
    }
}