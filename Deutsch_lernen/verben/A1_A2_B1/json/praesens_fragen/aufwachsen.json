{
  "praesens_fragen": {
    "ich": {
      "de": "Wo wachse ich auf?",
      "en": "Where do I grow up?",
      "es": "¿Dónde crezco?"
    },
    "du": {
      "de": "Bei wem wächst du auf?",
      "en": "Who do you grow up with?",
      "es": "¿Con quién te crías?"
    },
    "er": {
      "de": "Wo wächst er auf?",
      "en": "Where does he grow up?",
      "es": "¿Dónde crece él?"
    },
    "sie": {
      "de": "Wie wächst sie auf?",
      "en": "How does she grow up?",
      "es": "¿Cómo crece ella?"
    },
    "es": {
      "de": "Wo wächst das Kind auf?",
      "en": "Where does the child grow up?",
      "es": "¿Dónde crece el niño?"
    },
    "wir": {
      "de": "Wachsen wir auf dem Land auf?",
      "en": "Do we grow up in the countryside?",
      "es": "¿Crecemos en el campo?"
    },
    "ihr": {
      "de": "In welcher Stadt wachst ihr auf?",
      "en": "In which city do you grow up?",
      "es": "¿En qu ciudad crecéis?"
    },
    "sie (plural)": {
      "de": "Warum wachsen sie dort auf?",
      "en": "Why do they grow up there?",
      "es": "¿Por qu crecen allí?"
    },
    "Sie (formal)": {
      "de": "Wo wachsen Sie auf?",
      "en": "Where do you grow up?",
      "es": "¿Dónde crece usted?"
    }
  }
}
