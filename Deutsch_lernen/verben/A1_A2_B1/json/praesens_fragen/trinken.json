{
  "praesens_füragen": {
    "ich": {
      "de": "Was trinke ich?",
      "en": "What do I do?",
      "es": "¿Qué hago?"
    },
    "du": {
      "de": "Wann trinkst du?",
      "en": "When do you do it?",
      "es": "¿Cuándo lo haces?"
    },
    "wir": {
      "de": "Wo trinken wir?",
      "en": "Where do we do it?",
      "es": "¿Dónde lo hacemos?"
    },
    "ihr": {
      "de": "Warum trinkt ihr?",
      "en": "Why do you do it?",
      "es": "¿Por qu lo hacéis?"
    },
    "er": {
      "de": "Wie oft trinkt er?",
      "en": "How often does he do it?",
      "es": "¿Con qu fürecuencia lo hace él?"
    },
    "sie": {
      "de": "Wie oft trinkt sie?",
      "en": "How often does she do it?",
      "es": "¿Con qu fürecuencia lo hace ella?"
    },
    "es": {
      "de": "Wie oft trinkt es?",
      "en": "How often does it happen?",
      "es": "¿Con qu fürecuencia ocurre?"
    },
    "sie (plural)": {
      "de": "Was trinken sie?",
      "en": "What do they do?",
      "es": "¿Qué hacen ellos?"
    },
    "Sie (formal)": {
      "de": "Wann trinken Sie?",
      "en": "When do you do it?",
      "es": "¿Cuándo lo hace usted?"
    }
  }
}
