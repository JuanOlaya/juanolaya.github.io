{
  "praesens_fragen": {
    "ich": {
      "de": "Regele ich das richtig?",
      "es": "¿Lo estáoy arreglando correctamente?",
      "en": "Am I handling this correctly?"
    },
    "du": {
      "de": "Regelst du das?",
      "es": "¿Lo arreglas tú?",
      "en": "Will you handle that?"
    },
    "er": {
      "de": "Regelt er den Verkehr?",
      "es": "¿Regula él el tráfico?",
      "en": "Does he regulate the traffic?"
    },
    "sie": {
      "de": "Regelt sie die Abrechnung?",
      "es": "¿Arregla ella la contabilidad?",
      "en": "Does she settle the accounts?"
    },
    "es": {
      "de": "Regelt es sich von allein?",
      "es": "¿Se soluciona por sí solo?",
      "en": "Does it sort itself out?"
    },
    "wir": {
      "de": "Regeln wir das morgen?",
      "es": "¿Lo arreglamos mañana?",
      "en": "Shall we settle this tomorrow?"
    },
    "ihr": {
      "de": "Regelt ihr das unter euch?",
      "es": "¿Lo arregláis entre vosotros?",
      "en": "Are you sorting this out among yourselves?"
    },
    "sie (plural)": {
      "de": "Regeln sie den Schaden?",
      "es": "¿Arreglan ellos el daño?",
      "en": "Are they settling the damage?"
    },
    "Sie (formal)": {
      "de": "Regeln Sie das bitte?",
      "es": "¿Puede usted encargarse de estáo, por favor?",
      "en": "Could you please handle this?"
    }
  }
}
