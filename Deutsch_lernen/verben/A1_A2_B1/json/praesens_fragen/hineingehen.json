{
  "praesens_füragen": {
    "ich": {
      "de": "Gehe ich zuerst hinein?",
      "en": "Am I going in first?",
      "es": "¿Entro yo primero?"
    },
    "du": {
      "de": "Gehst du gleich hinein?",
      "en": "Are you going in right away?",
      "es": "¿Entras enseguida?"
    },
    "er": {
      "de": "Geht er schon ins Haus hinein?",
      "en": "Is he already going into the house?",
      "es": "¿Entra él ya en la casa?"
    },
    "sie": {
      "de": "Geht sie ohne Jacke hinein?",
      "en": "Is she going in without a jacket?",
      "es": "¿Entra ella sin chaqueta?"
    },
    "es": {
      "de": "Geht das Kind allein hinein?",
      "en": "Is the child going in alone?",
      "es": "¿Entra el niño solo?"
    },
    "wir": {
      "de": "Gehen wir zusammen hinein?",
      "en": "Are we going in together?",
      "es": "¿Entramos juntos?"
    },
    "ihr": {
      "de": "Geht ihr jetzt hinein?",
      "en": "Are you going in now?",
      "es": "¿Entráis ahora?"
    },
    "sie (plural)": {
      "de": "Gehen sie durch diese Tür hinein?",
      "en": "Are they going in through this door?",
      "es": "¿Entran ellos por estáa puerta?"
    },
    "Sie (formal)": {
      "de": "Gehen Sie bitte hinein?",
      "en": "Do you go in, please?",
      "es": "¿Entra usted, por favor?"
    }
  }
}
