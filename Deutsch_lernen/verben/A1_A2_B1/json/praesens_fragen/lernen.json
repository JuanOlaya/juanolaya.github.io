            "en": "What do I do?",
            "es": "¿Qué hago?"
        },
        "du": {
            "de": "Wann lernst du?",
            "en": "When do you do it?",
            "es": "¿Cuándo lo haces?"
        },
        "wir": {
            "de": "Wo lernen wir?",
            "en": "Where do we do it?",
            "es": "¿Dónde lo hacemos?"
        },
        "ihr": {
            "de": "Warum lernt ihr?",
            "en": "Why do you do it?",
            "es": "¿Por qu lo hacéis?"
        },
        "er": {
