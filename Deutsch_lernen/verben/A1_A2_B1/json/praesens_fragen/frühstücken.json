{
  "praesens_fragen": {
    "ich": {
      "de": "Frühstücke ich heute zu Hause?",
      "en": "Am I having breakfast at home today?",
      "es": "¿Desayuno hoy en casa?"
    },
    "du": {
      "de": "Frühstückst du heute im Café?",
      "en": "Are you having breakfast at the café today?",
      "es": "¿Desayunas hoy en el café?"
    },
    "er": {
      "de": "Frühstückt er schon?",
      "en": "Is he already having breakfast?",
      "es": "¿Está desayunando ya?"
    },
    "sie": {
      "de": "Frühstückt sie mit ihrer Schwester?",
      "en": "Is she having breakfast with her sister?",
      "es": "¿Desayuna ella con su hermana?"
    },
    "es": {
      "de": "Frühstückt das Kind im Kindergarten?",
      "en": "Is the child having breakfast at kindergarten?",
      "es": "¿Desayuna el niño en la guardería?"
    },
    "wir": {
      "de": "Frühstücken wir zusammen?",
      "en": "Are we having breakfast together?",
      "es": "¿Desayunamos juntos?"
    },
    "ihr": {
      "de": "Frühstückt ihr am Wochenende spät?",
      "en": "Do you have breakfast late on the weekend?",
      "es": "¿Desayunáis tarde el fin de semana?"
    },
    "sie (plural)": {
      "de": "Frühstücken sie im Hotel?",
      "en": "Are they having breakfast at the hotel?",
      "es": "¿Desayunan ellos en el hotel?"
    },
    "Sie (formal)": {
      "de": "Frühstücken Sie immer um sieben?",
