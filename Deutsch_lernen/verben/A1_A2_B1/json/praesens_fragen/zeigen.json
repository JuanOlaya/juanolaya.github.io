{
  "praesens_fragen": {
    "ich": {
      "de": "Was zeige ich dir?",
      "en": "What am I showing you?",
      "es": "¿Qué te muestáro?"
    },
    "du": {
      "de": "Zeigst du mir den Weg?",
      "en": "Will you show me the way?",
      "es": "¿Me muestáras el camino?"
    },
    "wir": {
      "de": "Was zeigen wir euch?",
      "en": "What are we showing you?",
      "es": "¿Qué os mostramos?"
    },
    "ihr": {
      "de": "Zeigt ihr uns die Fotos?",
      "en": "Will you show us the photos?",
      "es": "¿Nos mostráis las fotos?"
    },
    "er": {
      "de": "Was zeigt er?",
      "en": "What is he showing?",
      "es": "¿Qué muestára él?"
    },
    "sie": {
      "de": "Zeigt sie ihre Wohnung?",
      "en": "Is she showing her apartment?",
      "es": "¿Muestára ella su apartamento?"
    },
    "es": {
      "de": "Was zeigt das Thermometer?",
      "en": "What does the thermometer show?",
      "es": "¿Qué marca el termómetro?"
    },
    "sie (plural)": {
      "de": "Was zeigen sie uns?",
      "en": "What are they showing us?",
      "es": "¿Qué nos muestáran ellos?"
    },
    "Sie (formal)": {
      "de": "Was zeigen Sie mir?",
      "en": "What are you showing me?",
      "es": "¿Qué me muestára usted?"
    }
  }
}
