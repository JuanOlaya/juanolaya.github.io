{
    "praesens_fragen": {
        "ich": {
            "de": "Was drucke ich heute aus?",
            "en": "What am I printing out today?",
            "es": "¿Qué imprimo hoy?"
        },
        "du": {
            "de": "Druckst du das Dokument heute?",
            "en": "Are you printing the document today?",
            "es": "¿Imprimes hoy el documento?"
        },
        "er": {
            "de": "Wie oft druckt er?",
            "en": "How often does he print?",
            "es": "¿Con qu frecuencia imprime él?"
        },
        "sie": {
            "de": "Druckt sie die Fotos zu Hause?",
            "en": "Does she print the photos at home?",
            "es": "¿Imprime ella las fotos en casa?"
        },
        "es": {
            "de": "Druckt das Gerät noch?",
            "en": "Is the device still printing?",
            "es": "¿Imprime todavía el aparato?"
        },
        "wir": {
            "de": "Wo drucken wir die Tickets?",
            "en": "Where are we printing the tickets?",
            "es": "¿Dónde imprimimos los billetes?"
        },
        "ihr": {
            "de": "Druckt ihr die Hausaufgabe jetzt?",
            "en": "Are you printing the homework now?",
            "es": "¿Imprimís ahora la tarea?"
        },
        "sie (plural)": {
            "de": "Drucken sie die Plakate heute?",
            "en": "Are they printing the posters today?",
            "es": "¿Imprimen ellos hoy los carteles?"
        },
        "Sie (formal)": {
            "de": "Drucken Sie die Datei jetzt?",
            "en": "Are you printing the file now?",
            "es": "¿Imprime usted ahora el archivo?"
        }
