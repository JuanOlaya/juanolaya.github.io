    },
    "du": {
      "de": "Wann irrst dich?",
      "en": "When do you to be mistaken?",
      "es": "¿Cuándo equivocarse (tú)?"
    },
    "er": {
      "de": "Warum irrt sich?",
      "en": "Why does he to be mistaken?",
      "es": "¿Por qué equivocarse (él)?"
    },
    "sie": {
      "de": "Wie irrt sich?",
      "en": "How does she to be mistaken?",
      "es": "¿Cómo equivocarse (ella)?"
    },
    "es": {
