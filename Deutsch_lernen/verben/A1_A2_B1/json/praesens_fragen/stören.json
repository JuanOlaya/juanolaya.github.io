{
  "praesens_fragen": {
    "ich": {
      "de": "Was störene ich?",
      "en": "What do I do?",
      "es": "¿Qué hago?"
    },
    "du": {
      "de": "Wann störenst du?",
      "en": "When do you do it?",
      "es": "¿Cuándo lo haces?"
    },
    "wir": {
      "de": "Wo störenen wir?",
      "en": "Where do we do it?",
      "es": "¿Dónde lo hacemos?"
    },
    "ihr": {
      "de": "Warum störent ihr?",
      "en": "Why do you do it?",
      "es": "¿Por qué lo hacéis?"
    },
    "er": {
      "de": "Wie oft störent er?",
      "en": "How often does he do it?",
      "es": "¿Con qué frecuencia lo hace él?"
    },
    "sie": {
      "de": "Wie oft störent sie?",
      "en": "How often does she do it?",
      "es": "¿Con qué frecuencia lo hace ella?"
    },
    "es": {
      "de": "Wie oft störent es?",
      "en": "How often does it happen?",
      "es": "¿Con qué frecuencia ocurre?"
    },
    "sie (plural)": {
      "de": "Was störenen sie?",
      "en": "What do they do?",
      "es": "¿Qué hacen ellos?"
    },
    "Sie (formal)": {
      "de": "Wann störenen Sie?",
      "en": "When do you do it?",
      "es": "¿Cuándo lo hace usted?"
    }
  }
}
