{
  "praesens_fragen": {
    "ich": {
      "de": "Wem folge ich?",
      "en": "Who am I following?",
      "es": "¿A quién sigo?"
    },
    "du": {
      "de": "Folgst du mir?",
      "en": "Are you following me?",
      "es": "¿Me sigues?"
    },
    "wir": {
      "de": "Wem folgen wir?",
      "en": "Who are we following?",
      "es": "¿A quién seguimos?"
    },
    "ihr": {
      "de": "Folgt ihr dem Weg?",
      "en": "Are you following the path?",
      "es": "¿Seguís el camino?"
    },
    "er": {
      "de": "Folgt er seinem Traum?",
      "en": "Is he following his dream?",
      "es": "¿Sigue él su sueño?"
    },
    "sie": {
      "de": "Wem folgt sie?",
      "en": "Who is she following?",
      "es": "¿A quién sigue ella?"
    },
    "es": {
      "de": "Was folgt daraus?",
      "en": "What follows from that?",
      "es": "¿Qué se deduce de eso?"
    },
    "sie (plural)": {
      "de": "Folgen sie uns?",
      "en": "Are they following us?",
      "es": "¿Nos siguen ellos?"
    },
    "Sie (formal)": {
      "de": "Folgen Sie mir?",
      "en": "Are you following me?",
      "es": "¿Me sigue usted?"
    }
  }
}
