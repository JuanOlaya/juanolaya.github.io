            "en": "Where do we do it?",
            "es": "¿Dónde lo hacemos?"
        },
        "ihr": {
            "de": "Warum stellt vor ihr?",
            "en": "Why do you do it?",
            "es": "¿Por qu lo hacéis?"
        },
        "er": {
