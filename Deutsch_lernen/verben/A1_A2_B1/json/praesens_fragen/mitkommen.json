{
  "praesens_fragen": {
    "ich": {
      "de": "Was komme mit ich?",
      "en": "What do I do?",
      "es": "¿Qué hago?"
    },
    "du": {
      "de": "Wann kommst mit du?",
      "en": "When do you do it?",
      "es": "¿Cuándo lo haces?"
    },
    "wir": {
      "de": "Wo kommen mit wir?",
      "en": "Where do we do it?",
      "es": "¿Dónde lo hacemos?"
    },
    "ihr": {
      "de": "Warum kommt mit ihr?",
      "en": "Why do you do it?",
      "es": "¿Por qué lo hacéis?"
    },
    "er": {
      "de": "Wie oft kommt mit er?",
      "en": "How often does he do it?",
      "es": "¿Con qué frecuencia lo hace él?"
    },
    "sie": {
      "de": "Wie oft kommt mit sie?",
      "en": "How often does she do it?",
      "es": "¿Con qué frecuencia lo hace ella?"
    },
    "es": {
      "de": "Wie oft kommt mit es?",
      "en": "How often does it happen?",
      "es": "¿Con qué frecuencia ocurre?"
    },
    "sie (plural)": {
      "de": "Was kommen mit sie?",
      "en": "What do they do?",
      "es": "¿Qué hacen ellos?"
    },
    "Sie (formal)": {
      "de": "Wann kommen mit Sie?",
      "en": "When do you do it?",
      "es": "¿Cuándo lo hace usted?"
    }
  }
}
