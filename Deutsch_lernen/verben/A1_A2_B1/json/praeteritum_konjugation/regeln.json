{
  "praeteritum_conjugations": {
    "ich": "regelte",
    "du": "regeltest",
    "er": "regelte",
    "sie": "regelte",
    "es": "regelte",
    "wir": "regelten",
    "ihr": "regeltet",
    "sie (plural)": "regelten",
    "Sie (formal)": "regelten"
  },
  "praeteritum_examples": {
    "ich": {
      "de": "Ich regelte alles gestern.",
      "es": "Lo arreglé todo ayer.",
      "en": "I arranged everything yesterday."
    },
    "du": {
      "de": "Du regeltest das Problem schnell.",
      "es": "Solucionaste el problema rápido.",
      "en": "You solved the problem quickly."
    },
    "er": {
      "de": "Er regelte die Temperatur.",
      "es": "Él reguló la temperatura.",
      "en": "He regulated the temperature."
    },
    "sie": {
      "de": "Sie regelte den Verkehr.",
      "es": "Ella reguló el tráfico.",
      "en": "She regulated the traffic."
    },
    "es": {
      "de": "Das Thermostat regelte die Wärme.",
      "es": "El termostato regulaba el calor.",
      "en": "The thermostat regulated the heat."
    },
    "wir": {
      "de": "Wir regelten den Konflikt.",
      "es": "Arreglamos el conflicto.",
      "en": "We settled the conflict."
    },
    "ihr": {
      "de": "Regeltet ihr das?",
      "es": "¿Lo arreglasteis vosotros?",
      "en": "Did you arrange that?"
    },
    "sie (plural)": {
      "de": "Sie regelten die Details.",
      "es": "Ellos arreglaron los detalles.",
      "en": "They arranged the details."
    },
    "Sie (formal)": {
      "de": "Sie regelten die Angelegenheit diskret.",
      "es": "Usted arregló el asunto discretamente.",
      "en": "You handled the matter discreetly."
    }
  }
}
