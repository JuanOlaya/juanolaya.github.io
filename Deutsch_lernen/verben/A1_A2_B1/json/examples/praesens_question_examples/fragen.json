{
  "praesens_fragen": {
    "ich": {
      "de": "Was fürage ich?",
      "en": "What do I do?",
      "es": "¿Qué hago?"
    },
    "du": {
      "de": "Wann füragst du?",
      "en": "When do you do it?",
      "es": "¿Cuándo lo haces?"
    },
    "wir": {
      "de": "Wo fragen wir?",
      "en": "Where do we do it?",
      "es": "¿Dónde lo hacemos?"
    },
    "ihr": {
      "de": "Warum füragt ihr?",
      "en": "Why do you do it?",
      "es": "¿Por qu lo hacéis?"
    },
    "er": {
      "de": "Wie oft füragt er?",
      "en": "How often does he do it?",
      "es": "¿Con qu fürecuencia lo hace él?"
    },
    "sie": {
      "de": "Wie oft füragt sie?",
      "en": "How often does she do it?",
      "es": "¿Con qu fürecuencia lo hace ella?"
    },
    "es": {
      "de": "Wie oft füragt es?",
      "en": "How often does it happen?",
      "es": "¿Con qu fürecuencia ocurre?"
    },
    "sie (plural)": {
      "de": "Was fragen sie?",
      "en": "What do they do?",
      "es": "¿Qué hacen ellos?"
    },
    "Sie (formal)": {
      "de": "Wann fragen Sie?",
      "en": "When do you do it?",
      "es": "¿Cuándo lo hace usted?"
    }
  }
}
