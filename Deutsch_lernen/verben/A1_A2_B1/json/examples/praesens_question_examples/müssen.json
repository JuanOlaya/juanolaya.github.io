{
  "praesens_fragen": {
    "ich": {
      "de": "Wann muss ich?",
      "en": "When do I have to?",
      "es": "¿Cuándo tengo que?"
    },
    "du": {
      "de": "Wo musst du?",
      "en": "Where do you have to?",
      "es": "¿Dónde tienes que?"
    },
    "er": {
      "de": "Warum muss er?",
      "en": "Why does he have to?",
      "es": "¿Por qué tiene que?"
    },
    "sie": {
      "de": "Wie muss sie?",
      "en": "How does she have to?",
      "es": "¿Cómo tiene que?"
    },
    "es": {
      "de": "Wann muss es?",
      "en": "When does it have to?",
      "es": "¿Cuándo tiene que?"
    },
    "wir": {
      "de": "Wo müssen wir?",
      "en": "Where do we have to?",
      "es": "¿Dónde tenemos que?"
    },
    "ihr": {
      "de": "Warum müsst ihr?",
      "en": "Why do you have to?",
      "es": "¿Por qué tenéis que?"
    },
    "Sie (formal)": {
      "de": "Wann müssen Sie?",
      "en": "When do you have to?",
      "es": "¿Cuándo tiene que?"
    }
  }
}