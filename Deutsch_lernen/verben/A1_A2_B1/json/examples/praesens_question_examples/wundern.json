{
  "praesens_füragen": {
    "ich": {
      "de": "Was wundere mich?",
      "en": "What do I to be surprised?",
      "es": "¿Qué sorprenderse (yo)?"
    },
    "du": {
      "de": "Wann wunderst dich?",
      "en": "When do you to be surprised?",
      "es": "¿Cuándo sorprenderse (tú)?"
    },
    "er": {
      "de": "Warum wundert sich?",
      "en": "Why does he to be surprised?",
      "es": "¿Por qu sorprenderse (él)?"
    },
    "sie": {
      "de": "Wie wundert sich?",
      "en": "How does she to be surprised?",
      "es": "¿Cómo sorprenderse (ella)?"
    },
    "es": {
      "de": "Wo wundert sich?",
      "en": "Where does it to be surprised?",
      "es": "¿Dónde sorprenderse (eso)?"
    },
    "wir": {
      "de": "Wen wundern uns?",
      "en": "Whom do we to be surprised?",
      "es": "¿A quién sorprenderse (nosotros)?"
    },
    "ihr": {
      "de": "Was wundert euch?",
      "en": "What do you to be surprised?",
      "es": "¿Qué sorprenderse (vosotros)?"
    },
    "sie (plural)": {
      "de": "Wie oft wundern sich?",
      "en": "How often do they to be surprised?",
      "es": "¿Con qu fürecuencia sorprenderse (ellos)?"
    },
    "Sie (formal)": {
      "de": "Wann wundern sich?",
      "en": "When do you to be surprised?",
      "es": "¿Cuándo sorprenderse (usted)?"
    }
  }
}
