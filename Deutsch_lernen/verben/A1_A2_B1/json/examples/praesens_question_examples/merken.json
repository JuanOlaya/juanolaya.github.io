{
  "praesens_fragen": {
    "ich": {
      "de": "Merke ich mir das Wort?",
      "en": "Am I memorizing the word?",
      "es": "¿Me aprendo la palabra?"
    },
    "du": {
      "de": "Merkst du dir die Adresse?",
      "en": "Are you remembering the address?",
      "es": "¿Te aprendes la dirección?"
    },
    "er": {
      "de": "Merkt er sich den Termin?",
      "en": "Is he remembering the appointment?",
      "es": "¿Se aprende él la cita?"
    },
    "sie": {
      "de": "Merkt sie sich den Weg?",
      "en": "Is she remembering the way?",
      "es": "¿Se aprende ella el camino?"
    },
    "es": {
      "de": "Merkt sich das Kind das Lied?",
      "en": "Is the child remembering the song?",
      "es": "¿Se aprende el niño la canción?"
    },
    "wir": {
      "de": "Merken wir uns die Regel?",
      "en": "Are we remembering the rule?",
      "es": "¿Nos aprendemos la regla?"
    },
    "ihr": {
      "de": "Merkt ihr euch die Nummer?",
      "en": "Are you remembering the number?",
      "es": "¿Os aprendéis el número?"
    },
    "sie (plural)": {
      "de": "Merken sie sich die Uhrzeit?",
      "en": "Are they remembering the time?",
      "es": "¿Se aprenden ellos la hora?"
    },
    "Sie (formal)": {
      "de": "Merken Sie sich bitte meinen Namen?",
      "en": "Please remember my name.",
      "es": "¿Se aprende usted mi nombre, por favor?"
    }
  }
}
