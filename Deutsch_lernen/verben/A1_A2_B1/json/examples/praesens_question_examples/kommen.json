{
  "praesens_fragen": {
    "ich": {
      "de": "Wann komme ich?",
      "en": "When do I come?",
      "es": "¿Cuándo vengo?"
    },
    "du": {
      "de": "Woher kommst du?",
      "en": "Where do you come from?",
      "es": "¿De dónde eres?"
    },
    "er": {
      "de": "Kommt er aus Berlin?",
      "en": "Does he come from Berlin?",
      "es": "¿Él viene de Berlín?"
    },
    "sie": {
      "de": "Wann kommt sie an?",
      "en": "When does she arrive?",
      "es": "¿Cuándo llega ella?"
    },
    "es": {
      "de": "Woher kommt es?",
      "en": "Where does it come from?",
      "es": "¿De dónde viene?"
    },
    "wir": {
      "de": "Kommen wir zu spät?",
      "en": "Are we coming too late?",
      "es": "¿Llegamos tarde?"
    },
    "ihr": {
      "de": "Kommt ihr mit?",
      "en": "Are you coming along?",
      "es": "¿Venís con nosotros?"
    },
    "sie (plural)": {
      "de": "Wann kommen sie?",
      "en": "When are they coming?",
      "es": "¿Cuándo vienen?"
    },
    "Sie (formal)": {
      "de": "Woher kommen Sie?",
      "en": "Where do you come from?",
      "es": "¿De dónde es usted?"
    }
