{
  "praesens_fragen": {
    "ich": {
      "de": "Was verspreche ich?",
      "en": "What do I do?",
      "es": "¿Qué hago?"
    },
    "du": {
      "de": "Wann versprichst du?",
      "en": "When do you do it?",
      "es": "¿Cuándo lo haces?"
    },
    "wir": {
      "de": "Wo versprechen wir?",
      "en": "Where do we do it?",
      "es": "¿Dónde lo hacemos?"
    },
    "ihr": {
      "de": "Warum versprecht ihr?",
      "en": "Why do you do it?",
      "es": "¿Por qué lo hacéis?"
    },
    "er": {
      "de": "Wie oft verspricht er?",
      "en": "How often does he do it?",
      "es": "¿Con qué frecuencia lo hace él?"
    },
    "sie": {
      "de": "Wie oft verspricht sie?",
      "en": "How often does she do it?",
      "es": "¿Con qué frecuencia lo hace ella?"
    },
    "es": {
      "de": "Wie oft verspricht es?",
      "en": "How often does it happen?",
      "es": "¿Con qué frecuencia ocurre?"
    },
    "sie (plural)": {
      "de": "Was versprechen sie?",
      "en": "What do they do?",
      "es": "¿Qué hacen ellos?"
    },
    "Sie (formal)": {
      "de": "Wann versprechen Sie?",
      "en": "When do you do it?",
      "es": "¿Cuándo lo hace usted?"
    }
  }
}
