{
  "praesens_fragen": {
    "ich": {
      "de": "Was schlage vor ich?",
      "en": "What do I do?",
      "es": "¿Qué hago?"
    },
    "du": {
      "de": "Wann schlägst vor du?",
      "en": "When do you do it?",
      "es": "¿Cuándo lo haces?"
    },
    "wir": {
      "de": "Wo schlagen vor wir?",
      "en": "Where do we do it?",
      "es": "¿Dónde lo hacemos?"
    },
    "ihr": {
      "de": "Warum schlagt vor ihr?",
      "en": "Why do you do it?",
      "es": "¿Por qué lo hacéis?"
    },
    "er": {
      "de": "Wie oft schlägt vor er?",
      "en": "How often does he do it?",
      "es": "¿Con qué frecuencia lo hace él?"
    },
    "sie": {
      "de": "Wie oft schlägt vor sie?",
      "en": "How often does she do it?",
      "es": "¿Con qué frecuencia lo hace ella?"
    },
    "es": {
      "de": "Wie oft schlägt vor es?",
      "en": "How often does it happen?",
      "es": "¿Con qué frecuencia ocurre?"
    },
    "sie (plural)": {
      "de": "Was schlagen vor sie?",
      "en": "What do they do?",
      "es": "¿Qué hacen ellos?"
    },
    "Sie (formal)": {
      "de": "Wann schlagen vor Sie?",
      "en": "When do you do it?",
      "es": "¿Cuándo lo hace usted?"
    }
  }
}
