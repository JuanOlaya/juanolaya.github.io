{
  "praesens_fragen": {
    "ich": {
      "de": "Wann schlafe ich ein?",
      "en": "When do I fall asleep?",
      "es": "¿Cuándo me duermo?"
    },
    "du": {
      "de": "Wann schläfst du ein?",
      "en": "When do you fall asleep?",
      "es": "¿Cuándo te duermes?"
    },
    "er": {
      "de": "Warum schläft er so schnell ein?",
      "en": "Why does he fall asleep so quickly?",
      "es": "¿Por qué se duerme él tan rápido?"
    },
    "sie": {
      "de": "Schläft sie im Zug ein?",
      "en": "Does she fall asleep on the train?",
      "es": "¿Se duerme ella en el tren?"
    },
    "es": {
      "de": "Schläft das Baby schon ein?",
      "en": "Is the baby already falling asleep?",
      "es": "¿Se está durmiendo ya el bebé?"
    },
    "wir": {
      "de": "Schlafen wir heute früh ein?",
      "en": "Are we falling asleep early today?",
      "es": "¿Nos dormimos hoy temprano?"
    },
    "ihr": {
      "de": "Schlaft ihr im Film ein?",
      "en": "Do you fall asleep during the movie?",
      "es": "¿Os dormís durante la película?"
    },
    "sie (plural)": {
      "de": "Schlafen sie im Unterricht ein?",
      "en": "Do they fall asleep in class?",
      "es": "¿Se duermen ellos en clase?"
    },
    "Sie (formal)": {
      "de": "Schlafen Sie leicht ein?",
      "en": "Do you fall asleep easily?",
      "es": "¿Se duerme usted con facilidad?"
    }
  }
}
