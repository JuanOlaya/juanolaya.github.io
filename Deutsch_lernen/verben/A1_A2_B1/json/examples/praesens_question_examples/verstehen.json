{
  "praesens_fragen": {
    "ich": {
      "de": "Was verstehe ich?",
      "en": "What do I do?",
      "es": "¿Qué hago?"
    },
    "du": {
      "de": "Wann verstehst du?",
      "en": "When do you do it?",
      "es": "¿Cuándo lo haces?"
    },
    "wir": {
      "de": "Wo verstehen wir?",
      "en": "Where do we do it?",
      "es": "¿Dónde lo hacemos?"
    },
    "ihr": {
      "de": "Warum versteht ihr?",
      "en": "Why do you do it?",
      "es": "¿Por qu lo hacéis?"
    },
    "er": {
      "de": "Wie oft versteht er?",
      "en": "How often does he do it?",
      "es": "¿Con qu fürecuencia lo hace él?"
    },
    "sie": {
      "de": "Wie oft versteht sie?",
      "en": "How often does she do it?",
      "es": "¿Con qu fürecuencia lo hace ella?"
    },
    "es": {
      "de": "Wie oft versteht es?",
      "en": "How often does it happen?",
      "es": "¿Con qu fürecuencia ocurre?"
    },
    "sie (plural)": {
      "de": "Was verstehen sie?",
      "en": "What do they do?",
      "es": "¿Qué hacen ellos?"
    },
    "Sie (formal)": {
      "de": "Wann verstehen Sie?",
      "en": "When do you do it?",
      "es": "¿Cuándo lo hace usted?"
    }
  }
}
