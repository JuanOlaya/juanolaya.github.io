{
  "praesens_fragen": {
    "ich": {
      "de": "Wer bin ich?",
      "en": "Who am I?",
      "es": "¿Quién soy?"
    },
    "du": {
      "de": "Bist du müde?",
      "en": "Are you tired?",
      "es": "¿Estás cansado?"
    },
    "er": {
      "de": "Ist er hier?",
      "en": "Is he here?",
      "es": "¿Él está aquí?"
    },
    "sie": {
      "de": "Ist sie Ärztin?",
      "en": "Is she a doctor?",
      "es": "¿Ella es médica?"
    },
    "es": {
      "de": "Ist es kalt?",
      "en": "Is it cold?",
      "es": "¿Está frío? / ¿Hace frío?"
    },
    "wir": {
      "de": "Sind wir fertig?",
      "en": "Are we ready?",
      "es": "¿Estamos listos?"
    },
    "ihr": {
      "de": "Seid ihr da?",
      "en": "Are you there?",
      "es": "¿Estáis allí?"
    },
    "sie (plural)": {
      "de": "Sind sie glücklich?",
      "en": "Are they happy?",
      "es": "¿Son felices?"
    },
    "Sie (formal)": {
      "de": "Sind Sie verheiratet?",
      "en": "Are you married?",
      "es": "¿Está usted casado?"
    }
  }
}