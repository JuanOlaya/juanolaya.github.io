{
  "praesens_fragen": {
    "ich": {
      "de": "Was trage ich?",
      "en": "What am I wearing?",
      "es": "¿Qué llevo puesto?"
    },
    "du": {
      "de": "Trägst du eine Brille?",
      "en": "Do you wear glasses?",
      "es": "¿Llevas gafas?"
    },
    "wir": {
      "de": "Was tragen wir heute?",
      "en": "What are we wearing today?",
      "es": "¿Qué llevamos puesto hoy?"
    },
    "ihr": {
      "de": "Tragt ihr die Kisten?",
      "en": "Are you carrying the boxes?",
      "es": "¿Lleváis las cajas?"
    },
    "er": {
      "de": "Trägt er einen Anzug?",
      "en": "Is he wearing a suit?",
      "es": "¿Lleva él un traje?"
    },
    "sie": {
      "de": "Was trägt sie?",
      "en": "What is she wearing?",
      "es": "¿Qué lleva ella puesto?"
    },
    "es": {
      "de": "Trägt es Früchte?",
      "en": "Does it bear fruit?",
      "es": "¿Da fruto?"
    },
    "sie (plural)": {
      "de": "Tragen sie Hüte?",
      "en": "Are they wearing hats?",
      "es": "¿Llevan ellos sombreros?"
    },
    "Sie (formal)": {
      "de": "Was tragen Sie?",
      "en": "What are you wearing?",
      "es": "¿Qué lleva usted?"
    }
  }
}
