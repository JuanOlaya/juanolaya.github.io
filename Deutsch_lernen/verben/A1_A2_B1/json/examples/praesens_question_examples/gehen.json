{
  "praesens_fragen": {
    "ich": {
      "de": "Wohin gehe ich?",
      "en": "Where am I going?",
      "es": "¿Adónde voy?"
    },
    "du": {
      "de": "Gehst du schon?",
      "en": "Are you leaving already?",
      "es": "¿Ya te vas?"
    },
    "er": {
      "de": "Geht er nach Hause?",
      "en": "Is he going home?",
      "es": "¿Él va a casa?"
    },
    "sie": {
      "de": "Wohin geht sie?",
      "en": "Where is she going?",
      "es": "¿Adónde va ella?"
    },
    "es": {
      "de": "Geht es dir gut?",
      "en": "Are you doing well?",
      "es": "¿Te va bien?"
    },
    "wir": {
      "de": "Gehen wir ins Kino?",
      "en": "Are we going to the cinema?",
      "es": "¿Vamos al cine?"
    },
    "ihr": {
      "de": "Wie geht ihr?",
      "en": "How do you go?",
      "es": "¿Cómo vais?"
    },
    "sie (plural)": {
      "de": "Gehen sie spazieren?",
      "en": "Are they going for a walk?",
      "es": "¿Van a pasear?"
    },
    "Sie (formal)": {
      "de": "Wie geht es Ihnen?",
      "en": "How are you?",
      "es": "¿Cómo está usted?"
    }
  }
}