{
  "praesens_fragen": {
    "ich": {
      "de": "Treibe ich heute Sport?",
      "en": "Am I doing sports today?",
      "es": "¿Hago deporte hoy?"
    },
    "du": {
      "de": "Treibst du oft Sport?",
      "en": "Do you often do sports?",
      "es": "¿Haces deporte a menudo?"
    },
    "er": {
      "de": "Treibt er jeden Samstag Sport?",
      "en": "Does he do sports every Saturday?",
      "es": "¿Hace él deporte cada sábado?"
    },
    "sie": {
      "de": "Treibt sie im Verein Sport?",
      "en": "Does she do sports in a club?",
      "es": "¿Hace ella deporte en el club?"
    },
    "es": {
      "de": "Treibt das Kind schon Sport?",
      "en": "Does the child already do sports?",
      "es": "¿Hace ya deporte el niño?"
    },
    "wir": {
      "de": "Treiben wir heute Abend Sport?",
      "en": "Are we doing sports this evening?",
      "es": "¿Hacemos deporte esta tarde?"
    },
    "ihr": {
      "de": "Treibt ihr in der Halle Sport?",
      "en": "Do you do sports in the hall?",
      "es": "¿Hacéis deporte en el pabellón?"
    },
    "sie (plural)": {
      "de": "Treiben sie in der Schule Sport?",
      "en": "Do they do sports at school?",
      "es": "¿Hacen ellos deporte en la escuela?"
    },
    "Sie (formal)": {
      "de": "Treiben Sie noch Sport?",
      "en": "Do you still do sports?",
      "es": "¿Hace usted todavía deporte?"
    }
  }
}
