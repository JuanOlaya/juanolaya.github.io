{
  "praesens_fragen": {
    "ich": {
      "de": "Was wünsche mich?",
      "en": "What do I to wish?",
      "es": "¿Qué desear (yo)?"
    },
    "du": {
      "de": "Wann wünschst dich?",
      "en": "When do you to wish?",
      "es": "¿Cuándo desear (tú)?"
    },
    "er": {
      "de": "Warum wünscht sich?",
      "en": "Why does he to wish?",
      "es": "¿Por qué desear (él)?"
    },
    "sie": {
      "de": "Wie wünscht sich?",
      "en": "How does she to wish?",
      "es": "¿Cómo desear (ella)?"
    },
    "es": {
      "de": "Wo wünscht sich?",
      "en": "Where does it to wish?",
      "es": "¿Dónde desear (eso)?"
    },
    "wir": {
      "de": "Wen wünschen uns?",
      "en": "Whom do we to wish?",
      "es": "¿A quién desear (nosotros)?"
    },
    "ihr": {
      "de": "Was wünscht euch?",
      "en": "What do you to wish?",
      "es": "¿Qué desear (vosotros)?"
    },
    "sie (plural)": {
      "de": "Wie oft wünschen sich?",
      "en": "How often do they to wish?",
      "es": "¿Con qué frecuencia desear (ellos)?"
    },
    "Sie (formal)": {
      "de": "Wann wünschen sich?",
      "en": "When do you to wish?",
      "es": "¿Cuándo desear (usted)?"
    }
  }
}
