{
  "praesens_examples": {
    "ich": {
      "de": "Ich huste seit gestern.",
      "en": "I've been coughing since yesterday.",
      "es": "Toso desde ayer."
    },
    "du": {
      "de": "Du hustest die ganze Nacht.",
      "en": "You cough all night.",
      "es": "Toses toda la noche."
    },
    "er": {
      "de": "Er hustet wegen der Erkältung.",
      "en": "He coughs because of the cold.",
      "es": "Él tose por el resfriado."
    },
    "sie": {
      "de": "Sie hustet im Unterricht.",
      "en": "She coughs in class.",
      "es": "Ella tose en clase."
    },
    "es": {
      "de": "Das Kind hustet seit zwei Tagen.",
      "en": "The child has been coughing for two days.",
      "es": "El niño tose desde hace dos días."
    },
    "wir": {
      "de": "Wir husten alle.",
      "en": "We all cough.",
      "es": "Todos tosemos."
    },
    "ihr": {
      "de": "Ihr hustet beide stark.",
      "en": "You both cough strongly.",
      "es": "Vosotros dos toséis fuerte."
    },
    "sie (plural)": {
      "de": "Sie husten wegen des Rauchs.",
      "en": "They cough because of the smoke.",
      "es": "Ellos tosen por el humo."
    },
    "Sie (formal)": {
      "de": "Sie husten schon seit einer Woche.",
      "en": "You've been coughing for a week.",
      "es": "Usted tose desde hace una semana."
    }
  }
}
