{
  "praeteritum_examples": {
    "ich": {
      "de": "Ich zog nach Berlin um.",
      "es": "Me mudé a Berlín.",
      "en": "I moved to Berlin."
    },
    "du": {
      "de": "Du zogst in eine neue Wohnung um.",
      "es": "Te mudaste a un apartamento nuevo.",
      "en": "You moved to a new apartment."
    },
    "er": {
      "de": "Er zog letztes Jahr um.",
      "es": "Él se mudó el año pasado.",
      "en": "He moved last year."
    },
    "sie": {
      "de": "Sie zog nach München um.",
      "es": "Ella se mudó a Múnich.",
      "en": "She moved to Munich."
    },
    "es": {
      "de": "Es zog in ein neues Gebäude um.",
      "es": "Se mudó a un nuevo edificio.",
      "en": "It moved to a new building."
    },
    "wir": {
      "de": "Wir zogen im Sommer um.",
      "es": "Nos mudamos en verano.",
      "en": "We moved in summer."
    },
    "ihr": {
      "de": "Ihr zogt zusammen um.",
      "es": "Os mudasteis juntos.",
      "en": "You moved together."
    },
    "sie (plural)": {
      "de": "Sie zogen nach Hamburg um.",
      "es": "Se mudaron a Hamburgo.",
      "en": "They moved to Hamburg."
    },
    "Sie (formal)": {
      "de": "Sie zogen in ein Haus um.",
      "es": "Se mudó a una casa.",
      "en": "You moved to a house."
    }
  }
}
