      "de": "Traust du mir?",
      "en": "Do you trust me?",
      "es": "¿Confías en mí?"
    },
    "er": {
      "de": "Er traut sich nicht zu fragen.",
      "en": "He doesn't dare to ask.",
      "es": "Él no se atreve a preguntar."
    },
    "sie": {
      "de": "Sie traut ihrem Instinkt.",
      "en": "She trusts her instinct.",
      "es": "Ella confía en su instinto."
    },
    "es": {
      "de": "Es traut sich aus dem Haus.",
      "en": "It dares [to go] out of the house.",
      "es": "Se atreve a salir de casa."
    },
    "wir": {
      "de": "Wir trauen dem Wetter nicht.",
      "en": "We don't trust the weather.",
      "es": "No nos fiamos del tiempo."
    },
    "ihr": {
      "de": "Traut ihr euch?",
      "en": "Do you dare?",
      "es": "¿Os atrevéis?"
    },
    "sie (plural)": {
      "de": "Sie trauen einander nicht.",
      "en": "They don't trust each other.",
      "es": "Ellos no se fían el uno del otro."
    },
