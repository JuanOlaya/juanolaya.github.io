      "en": "She spells her surname.",
      "es": "Ella deletrea su apellido."
    },
    "es": {
      "de": "Das Kind buchstabiert das Wort.",
      "en": "The child spells the word.",
      "es": "El niño deletrea la palabra."
    },
    "wir": {
      "de": "Wir buchstabieren den Ortsnamen.",
      "en": "We spell the place name.",
      "es": "Deletreamos el nombre del lugar."
    },
    "ihr": {
      "de": "Ihr buchstabiert das Wort richtig.",
      "en": "You spell the word correctly.",
      "es": "Deletreáis bien la palabra."
    },
    "sie (plural)": {
      "de": "Sie buchstabieren die Namen.",
      "en": "They spell the names.",
      "es": "Ellos deletrean los nombres."
