  <h1>🧠 Abstraktes deutsches Substantiv</h1>

  <details id="abstraktes-deutsches-substantiv-section" open>
    <summary>Abstraktes deutsches Substantiv</summary>
    <div class="content-wrapper">
      <table>
        <thead>
          <tr>
            <th data-label="Substantiv">🇩🇪 Substantiv <br/> 🇬🇧 Noun</th>
            <th data-label="Aussprache Englisch Spanisch">🇩🇪 Aussprache <br/> 🇬🇧 Englisch <br/> 🇪🇸 Spanisch</th>
            <th data-label="Definiter Artikel (Nominativ)">Definiter Artikel (Nominativ) <br/> <a href="faelle.html#nominative" style="color: #3b82f6; text-decoration: underline; font-size: 0.9em;">Sujeto</a></th>
            <th data-label="Definiter Artikel (Akkusativ)">Definiter Artikel (Akkusativ) <br/> <a href="faelle.html#accusative" style="color: #3b82f6; text-decoration: underline; font-size: 0.9em;">Objeto Directo</a></th>
            <th data-label="Indefiniter Artikel (Nominativ)">Indefiniter Artikel (Nominativ) <br/> <a href="faelle.html#nominative" style="color: #3b82f6; text-decoration: underline; font-size: 0.9em;">Sujeto</a></th>
            <th data-label="Indefiniter Artikel (Akkusativ)">Indefiniter Artikel (Akkusativ) <br/> <a href="faelle.html#accusative" style="color: #3b82f6; text-decoration: underline; font-size: 0.9em;">Objeto Directo</a></th>
            <th data-label="Negation (Nominativ)">Negation (Nominativ) <br/> <a href="faelle.html#nominative" style="color: #3b82f6; text-decoration: underline; font-size: 0.9em;">Sujeto</a></th>
            <th data-label="Negation (Akkusativ)">Negation (Akkusativ) <br/> <a href="faelle.html#accusative" style="color: #3b82f6; text-decoration: underline; font-size: 0.9em;">Objeto Directo</a></th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td data-label="Substantiv"><strong><span class="die-color">die Zeit</span></strong> <br/> ⏰</td>
            <td data-label="Aussprache Englisch Spanisch">🇩🇪 /tsait/<span class="translation"> <br/> 🇬🇧 <i>Time</i> <br/> 🇪🇸 <i>Tiempo</i></span></td>
            <td data-label="Definiter Artikel (Nominativ)"><span><strong><span class="die-color">Die Zeit</span></strong> vergeht schnell.</span><span class="translation"><br/>🇬🇧 <i>Time passes quickly.</i><br/>🇪🇸 <i>El tiempo pasa rápido.</i></span></td>
            <td data-label="Definiter Artikel (Akkusativ)"><span>Ich brauche <strong><span class="die-color">die Zeit</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I need time.</i><br/>🇪🇸 <i>Necesito tiempo.</i></span></td>
            <td data-label="Indefiniter Artikel (Nominativ)"><span>Das ist <strong><span class="die-color">eine</span></strong> gute <strong><span class="die-color">Zeit</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>This is a good time.</i><br/>🇪🇸 <i>Este es un buen momento.</i></span></td>
            <td data-label="Indefiniter Artikel (Akkusativ)"><span>Ich habe <strong><span class="die-color">eine</span></strong> gute <strong><span class="die-color">Zeit</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I have a good time.</i><br/>🇪🇸 <i>Tengo un buen momento.</i></span></td>
            <td data-label="Negation (Nominativ)"><span><strong><span class="die-color">Keine Zeit</span></strong> ist da.</span><span class="translation"><br/>🇬🇧 <i>No time is there.</i><br/>🇪🇸 <i>No hay tiempo.</i></span></td>
            <td data-label="Negation (Akkusativ)"><span>Ich habe <strong><span class="die-color">keine Zeit</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I have no time.</i><br/>🇪🇸 <i>No tengo tiempo.</i></span></td>
          </tr>
          <tr>
            <td data-label="Substantiv"><strong><span class="das-color">das Geld</span></strong> <br/> 💰</td>
            <td data-label="Aussprache Englisch Spanisch">🇩🇪 /gelt/<span class="translation"> <br/> 🇬🇧 <i>Money</i> <br/> 🇪🇸 <i>Dinero</i></span></td>
            <td data-label="Definiter Artikel (Nominativ)"><span><strong><span class="das-color">Das Geld</span></strong> ist wichtig.</span><span class="translation"><br/>🇬🇧 <i>Money is important.</i><br/>🇪🇸 <i>El dinero es importante.</i></span></td>
            <td data-label="Definiter Artikel (Akkusativ)"><span>Ich brauche <strong><span class="das-color">das Geld</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I need money.</i><br/>🇪🇸 <i>Necesito dinero.</i></span></td>
            <td data-label="Indefiniter Artikel (Nominativ)"><span>Hier ist <strong><span class="das-color">ein Geld</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>Here is some money.</i><br/>🇪🇸 <i>Aquí hay dinero.</i></span></td>
            <td data-label="Indefiniter Artikel (Akkusativ)"><span>Ich habe <strong><span class="das-color">ein Geld</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I have some money.</i><br/>🇪🇸 <i>Tengo dinero.</i></span></td>
            <td data-label="Negation (Nominativ)"><span><strong><span class="das-color">Kein Geld</span></strong> ist da.</span><span class="translation"><br/>🇬🇧 <i>No money is there.</i><br/>🇪🇸 <i>No hay dinero.</i></span></td>
            <td data-label="Negation (Akkusativ)"><span>Ich habe <strong><span class="das-color">kein Geld</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I have no money.</i><br/>🇪🇸 <i>No tengo dinero.</i></span></td>
          </tr>
          <tr>
            <td data-label="Substantiv"><strong><span class="die-color">die Liebe</span></strong> <br/> ❤️</td>
            <td data-label="Aussprache Englisch Spanisch">🇩🇪 /LI-be/<span class="translation"> <br/> 🇬🇧 <i>Love</i> <br/> 🇪🇸 <i>Amor</i></span></td>
            <td data-label="Definiter Artikel (Nominativ)"><span><strong><span class="die-color">Die Liebe</span></strong> ist schön.</span><span class="translation"><br/>🇬🇧 <i>Love is beautiful.</i><br/>🇪🇸 <i>El amor es hermoso.</i></span></td>
            <td data-label="Definiter Artikel (Akkusativ)"><span>Ich fühle <strong><span class="die-color">die Liebe</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I feel love.</i><br/>🇪🇸 <i>Siento amor.</i></span></td>
            <td data-label="Indefiniter Artikel (Nominativ)"><span>Das ist <strong><span class="die-color">eine</span></strong> große <strong><span class="die-color">Liebe</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>This is a great love.</i><br/>🇪🇸 <i>Este es un gran amor.</i></span></td>
            <td data-label="Indefiniter Artikel (Akkusativ)"><span>Ich finde <strong><span class="die-color">eine</span></strong> große <strong><span class="die-color">Liebe</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I find great love.</i><br/>🇪🇸 <i>Encuentro un gran amor.</i></span></td>
            <td data-label="Negation (Nominativ)"><span><strong><span class="die-color">Keine Liebe</span></strong> ist da.</span><span class="translation"><br/>🇬🇧 <i>No love is there.</i><br/>🇪🇸 <i>No hay amor.</i></span></td>
            <td data-label="Negation (Akkusativ)"><span>Ich fühle <strong><span class="die-color">keine Liebe</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I feel no love.</i><br/>🇪🇸 <i>No siento amor.</i></span></td>
          </tr>
          <tr>
            <td data-label="Substantiv"><strong><span class="das-color">das Leben</span></strong> <br/> 🌱</td>
            <td data-label="Aussprache Englisch Spanisch">🇩🇪 /LE-ben/<span class="translation"> <br/> 🇬🇧 <i>Life</i> <br/> 🇪🇸 <i>Vida</i></span></td>
            <td data-label="Definiter Artikel (Nominativ)"><span><strong><span class="das-color">Das Leben</span></strong> ist wunderbar.</span><span class="translation"><br/>🇬🇧 <i>Life is wonderful.</i><br/>🇪🇸 <i>La vida es maravillosa.</i></span></td>
            <td data-label="Definiter Artikel (Akkusativ)"><span>Ich liebe <strong><span class="das-color">das Leben</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I love life.</i><br/>🇪🇸 <i>Amo la vida.</i></span></td>
            <td data-label="Indefiniter Artikel (Nominativ)"><span>Das ist <strong><span class="das-color">ein</span></strong> neues <strong><span class="das-color">Leben</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>This is a new life.</i><br/>🇪🇸 <i>Esta es una nueva vida.</i></span></td>
            <td data-label="Indefiniter Artikel (Akkusativ)"><span>Ich beginne <strong><span class="das-color">ein</span></strong> neues <strong><span class="das-color">Leben</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I begin a new life.</i><br/>🇪🇸 <i>Comienzo una nueva vida.</i></span></td>
            <td data-label="Negation (Nominativ)"><span><strong><span class="das-color">Kein Leben</span></strong> ist da.</span><span class="translation"><br/>🇬🇧 <i>No life is there.</i><br/>🇪🇸 <i>No hay vida.</i></span></td>
            <td data-label="Negation (Akkusativ)"><span>Ich habe <strong><span class="das-color">kein Leben</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I have no life.</i><br/>🇪🇸 <i>No tengo vida.</i></span></td>
          </tr>
          <tr>
            <td data-label="Substantiv"><strong><span class="die-color">die Arbeit</span></strong> <br/> 💼</td>
            <td data-label="Aussprache Englisch Spanisch">🇩🇪 /AR-bait/<span class="translation"> <br/> 🇬🇧 <i>Work</i> <br/> 🇪🇸 <i>Trabajo</i></span></td>
            <td data-label="Definiter Artikel (Nominativ)"><span><strong><span class="die-color">Die Arbeit</span></strong> ist wichtig.</span><span class="translation"><br/>🇬🇧 <i>Work is important.</i><br/>🇪🇸 <i>El trabajo es importante.</i></span></td>
            <td data-label="Definiter Artikel (Akkusativ)"><span>Ich mache <strong><span class="die-color">die Arbeit</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I do the work.</i><br/>🇪🇸 <i>Hago el trabajo.</i></span></td>
            <td data-label="Indefiniter Artikel (Nominativ)"><span>Das ist <strong><span class="die-color">eine</span></strong> gute <strong><span class="die-color">Arbeit</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>This is good work.</i><br/>🇪🇸 <i>Este es un buen trabajo.</i></span></td>
            <td data-label="Indefiniter Artikel (Akkusativ)"><span>Ich finde <strong><span class="die-color">eine</span></strong> gute <strong><span class="die-color">Arbeit</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I find good work.</i><br/>🇪🇸 <i>Encuentro un buen trabajo.</i></span></td>
            <td data-label="Negation (Nominativ)"><span><strong><span class="die-color">Keine Arbeit</span></strong> ist da.</span><span class="translation"><br/>🇬🇧 <i>No work is there.</i><br/>🇪🇸 <i>No hay trabajo.</i></span></td>
            <td data-label="Negation (Akkusativ)"><span>Ich habe <strong><span class="die-color">keine Arbeit</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I have no work.</i><br/>🇪🇸 <i>No tengo trabajo.</i></span></td>
          </tr>
          <tr>
            <td data-label="Substantiv"><strong><span class="die-color">die Gesundheit</span></strong> <br/> 🏥</td>
            <td data-label="Aussprache Englisch Spanisch">🇩🇪 /ge-ZUNT-hait/<span class="translation"> <br/> 🇬🇧 <i>Health</i> <br/> 🇪🇸 <i>Salud</i></span></td>
            <td data-label="Definiter Artikel (Nominativ)"><span><strong><span class="die-color">Die Gesundheit</span></strong> ist wertvoll.</span><span class="translation"><br/>🇬🇧 <i>Health is valuable.</i><br/>🇪🇸 <i>La salud es valiosa.</i></span></td>
            <td data-label="Definiter Artikel (Akkusativ)"><span>Ich schätze <strong><span class="die-color">die Gesundheit</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I value health.</i><br/>🇪🇸 <i>Valoro la salud.</i></span></td>
            <td data-label="Indefiniter Artikel (Nominativ)"><span>Das ist <strong><span class="die-color">eine</span></strong> gute <strong><span class="die-color">Gesundheit</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>This is good health.</i><br/>🇪🇸 <i>Esta es buena salud.</i></span></td>
            <td data-label="Indefiniter Artikel (Akkusativ)"><span>Ich wünsche <strong><span class="die-color">eine</span></strong> gute <strong><span class="die-color">Gesundheit</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I wish for good health.</i><br/>🇪🇸 <i>Deseo buena salud.</i></span></td>
            <td data-label="Negation (Nominativ)"><span><strong><span class="die-color">Keine Gesundheit</span></strong> ist da.</span><span class="translation"><br/>🇬🇧 <i>No health is there.</i><br/>🇪🇸 <i>No hay salud.</i></span></td>
            <td data-label="Negation (Akkusativ)"><span>Er hat <strong><span class="die-color">keine Gesundheit</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>He has no health.</i><br/>🇪🇸 <i>Él no tiene salud.</i></span></td>
          </tr>
          <tr>
            <td data-label="Substantiv"><strong><span class="die-color">die Bildung</span></strong> <br/> 🎓</td>
            <td data-label="Aussprache Englisch Spanisch">🇩🇪 /BIL-dung/<span class="translation"> <br/> 🇬🇧 <i>Education</i> <br/> 🇪🇸 <i>Educación</i></span></td>
            <td data-label="Definiter Artikel (Nominativ)"><span><strong><span class="die-color">Die Bildung</span></strong> ist fundamental.</span><span class="translation"><br/>🇬🇧 <i>Education is fundamental.</i><br/>🇪🇸 <i>La educación es fundamental.</i></span></td>
            <td data-label="Definiter Artikel (Akkusativ)"><span>Ich schätze <strong><span class="die-color">die Bildung</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I value education.</i><br/>🇪🇸 <i>Valoro la educación.</i></span></td>
            <td data-label="Indefiniter Artikel (Nominativ)"><span>Das ist <strong><span class="die-color">eine</span></strong> gute <strong><span class="die-color">Bildung</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>This is good education.</i><br/>🇪🇸 <i>Esta es buena educación.</i></span></td>
            <td data-label="Indefiniter Artikel (Akkusativ)"><span>Er hat <strong><span class="die-color">eine</span></strong> gute <strong><span class="die-color">Bildung</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>He has good education.</i><br/>🇪🇸 <i>Él tiene buena educación.</i></span></td>
            <td data-label="Negation (Nominativ)"><span><strong><span class="die-color">Keine Bildung</span></strong> ist da.</span><span class="translation"><br/>🇬🇧 <i>No education is there.</i><br/>🇪🇸 <i>No hay educación.</i></span></td>
            <td data-label="Negation (Akkusativ)"><span>Er hat <strong><span class="die-color">keine Bildung</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>He has no education.</i><br/>🇪🇸 <i>Él no tiene educación.</i></span></td>
          </tr>
          <tr>
            <td data-label="Substantiv"><strong><span class="die-color">die Freiheit</span></strong> <br/> 🕊️</td>
            <td data-label="Aussprache Englisch Spanisch">🇩🇪 /FRAI-hait/<span class="translation"> <br/> 🇬🇧 <i>Freedom</i> <br/> 🇪🇸 <i>Libertad</i></span></td>
            <td data-label="Definiter Artikel (Nominativ)"><span><strong><span class="die-color">Die Freiheit</span></strong> ist wichtig.</span><span class="translation"><br/>🇬🇧 <i>Freedom is important.</i><br/>🇪🇸 <i>La libertad es importante.</i></span></td>
            <td data-label="Definiter Artikel (Akkusativ)"><span>Ich liebe <strong><span class="die-color">die Freiheit</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I love freedom.</i><br/>🇪🇸 <i>Amo la libertad.</i></span></td>
            <td data-label="Indefiniter Artikel (Nominativ)"><span>Das ist <strong><span class="die-color">eine</span></strong> neue <strong><span class="die-color">Freiheit</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>This is new freedom.</i><br/>🇪🇸 <i>Esta es nueva libertad.</i></span></td>
            <td data-label="Indefiniter Artikel (Akkusativ)"><span>Ich wünsche <strong><span class="die-color">eine</span></strong> neue <strong><span class="die-color">Freiheit</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I wish for new freedom.</i><br/>🇪🇸 <i>Deseo nueva libertad.</i></span></td>
            <td data-label="Negation (Nominativ)"><span><strong><span class="die-color">Keine Freiheit</span></strong> ist da.</span><span class="translation"><br/>🇬🇧 <i>No freedom is there.</i><br/>🇪🇸 <i>No hay libertad.</i></span></td>
            <td data-label="Negation (Akkusativ)"><span>Es gibt <strong><span class="die-color">keine Freiheit</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>There is no freedom.</i><br/>🇪🇸 <i>No hay libertad.</i></span></td>
          </tr>
          <tr>
            <td data-label="Substantiv"><strong><span class="das-color">das Glück</span></strong> <br/> 🍀</td>
            <td data-label="Aussprache Englisch Spanisch">🇩🇪 /glük/<span class="translation"> <br/> 🇬🇧 <i>Happiness / Luck</i> <br/> 🇪🇸 <i>Felicidad / Suerte</i></span></td>
            <td data-label="Definiter Artikel (Nominativ)"><span><strong><span class="das-color">Das Glück</span></strong> ist schön.</span><span class="translation"><br/>🇬🇧 <i>Happiness is beautiful.</i><br/>🇪🇸 <i>La felicidad es hermosa.</i></span></td>
            <td data-label="Definiter Artikel (Akkusativ)"><span>Ich suche <strong><span class="das-color">das Glück</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I seek happiness.</i><br/>🇪🇸 <i>Busco la felicidad.</i></span></td>
            <td data-label="Indefiniter Artikel (Nominativ)"><span>Das ist <strong><span class="das-color">ein</span></strong> großes <strong><span class="das-color">Glück</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>This is great happiness.</i><br/>🇪🇸 <i>Esta es gran felicidad.</i></span></td>
            <td data-label="Indefiniter Artikel (Akkusativ)"><span>Ich habe <strong><span class="das-color">ein</span></strong> großes <strong><span class="das-color">Glück</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I have great happiness.</i><br/>🇪🇸 <i>Tengo gran felicidad.</i></span></td>
            <td data-label="Negation (Nominativ)"><span><strong><span class="das-color">Kein Glück</span></strong> ist da.</span><span class="translation"><br/>🇬🇧 <i>No happiness is there.</i><br/>🇪🇸 <i>No hay felicidad.</i></span></td>
            <td data-label="Negation (Akkusativ)"><span>Ich habe <strong><span class="das-color">kein Glück</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I have no luck.</i><br/>🇪🇸 <i>No tengo suerte.</i></span></td>
          </tr>
          <tr>
            <td data-label="Substantiv"><strong><span class="die-color">die Hoffnung</span></strong> <br/> 🌈</td>
            <td data-label="Aussprache Englisch Spanisch">🇩🇪 /HOF-nung/<span class="translation"> <br/> 🇬🇧 <i>Hope</i> <br/> 🇪🇸 <i>Esperanza</i></span></td>
            <td data-label="Definiter Artikel (Nominativ)"><span><strong><span class="die-color">Die Hoffnung</span></strong> ist wichtig.</span><span class="translation"><br/>🇬🇧 <i>Hope is important.</i><br/>🇪🇸 <i>La esperanza es importante.</i></span></td>
            <td data-label="Definiter Artikel (Akkusativ)"><span>Ich habe <strong><span class="die-color">die Hoffnung</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I have hope.</i><br/>🇪🇸 <i>Tengo esperanza.</i></span></td>
            <td data-label="Indefiniter Artikel (Nominativ)"><span>Das ist <strong><span class="die-color">eine</span></strong> große <strong><span class="die-color">Hoffnung</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>This is great hope.</i><br/>🇪🇸 <i>Esta es gran esperanza.</i></span></td>
            <td data-label="Indefiniter Artikel (Akkusativ)"><span>Ich finde <strong><span class="die-color">eine</span></strong> große <strong><span class="die-color">Hoffnung</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I find great hope.</i><br/>🇪🇸 <i>Encuentro gran esperanza.</i></span></td>
            <td data-label="Negation (Nominativ)"><span><strong><span class="die-color">Keine Hoffnung</span></strong> ist da.</span><span class="translation"><br/>🇬🇧 <i>No hope is there.</i><br/>🇪🇸 <i>No hay esperanza.</i></span></td>
            <td data-label="Negation (Akkusativ)"><span>Ich habe <strong><span class="die-color">keine Hoffnung</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I have no hope.</i><br/>🇪🇸 <i>No tengo esperanza.</i></span></td>
          </tr>
          <tr>
            <td data-label="Substantiv"><strong><span class="die-color">die Angst</span></strong> <br/> 😰</td>
            <td data-label="Aussprache Englisch Spanisch">🇩🇪 /angst/<span class="translation"> <br/> 🇬🇧 <i>Fear</i> <br/> 🇪🇸 <i>Miedo</i></span></td>
            <td data-label="Definiter Artikel (Nominativ)"><span><strong><span class="die-color">Die Angst</span></strong> ist normal.</span><span class="translation"><br/>🇬🇧 <i>Fear is normal.</i><br/>🇪🇸 <i>El miedo es normal.</i></span></td>
            <td data-label="Definiter Artikel (Akkusativ)"><span>Ich fühle <strong><span class="die-color">die Angst</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I feel fear.</i><br/>🇪🇸 <i>Siento miedo.</i></span></td>
            <td data-label="Indefiniter Artikel (Nominativ)"><span>Das ist <strong><span class="die-color">eine</span></strong> große <strong><span class="die-color">Angst</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>This is great fear.</i><br/>🇪🇸 <i>Este es gran miedo.</i></span></td>
            <td data-label="Indefiniter Artikel (Akkusativ)"><span>Ich habe <strong><span class="die-color">eine</span></strong> große <strong><span class="die-color">Angst</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I have great fear.</i><br/>🇪🇸 <i>Tengo gran miedo.</i></span></td>
            <td data-label="Negation (Nominativ)"><span><strong><span class="die-color">Keine Angst</span></strong> ist da.</span><span class="translation"><br/>🇬🇧 <i>No fear is there.</i><br/>🇪🇸 <i>No hay miedo.</i></span></td>
            <td data-label="Negation (Akkusativ)"><span>Ich habe <strong><span class="die-color">keine Angst</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I have no fear.</i><br/>🇪🇸 <i>No tengo miedo.</i></span></td>
          </tr>
          <tr>
            <td data-label="Substantiv"><strong><span class="der-color">der Mut</span></strong> <br/> 🦁</td>
            <td data-label="Aussprache Englisch Spanisch">🇩🇪 /mu:t/<span class="translation"> <br/> 🇬🇧 <i>Courage</i> <br/> 🇪🇸 <i>Coraje / Valentía</i></span></td>
            <td data-label="Beispielsatz"><span>Du hast viel <strong><span class="der-color">Mut</span></strong>.</span> <span class="translation"><br/> 🇬🇧 <i>You have much courage.</i> <br/> 🇪🇸 <i>Tienes mucho coraje.</i></span></td>
            <td data-label="Beispielsatz"><span>Er zeigt <strong><span class="der-color">Mut</span></strong>.</span> <span class="translation"><br/> 🇬🇧 <i>He shows courage.</i> <br/> 🇪🇸 <i>Él muestra coraje.</i></span></td>
            <td data-label="Definiter Artikel (Nominativ)"><span><strong><span class="der-color">Der Mut</span></strong> ist wichtig.</span><span class="translation"><br/>🇬🇧 <i>Courage is important.</i><br/>🇪🇸 <i>El coraje es importante.</i></span></td>
            <td data-label="Definiter Artikel (Akkusativ)"><span>Ich zeige <strong><span class="der-color">den Mut</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I show courage.</i><br/>🇪🇸 <i>Muestro coraje.</i></span></td>
            <td data-label="Indefiniter Artikel (Nominativ)"><span>Das ist <strong><span class="der-color">ein</span></strong> großer <strong><span class="der-color">Mut</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>This is great courage.</i><br/>🇪🇸 <i>Este es gran coraje.</i></span></td>
            <td data-label="Indefiniter Artikel (Akkusativ)"><span>Er hat <strong><span class="der-color">einen</span></strong> großen <strong><span class="der-color">Mut</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>He has great courage.</i><br/>🇪🇸 <i>Él tiene gran coraje.</i></span></td>
            <td data-label="Negation (Nominativ)"><span><strong><span class="der-color">Kein Mut</span></strong> ist da.</span><span class="translation"><br/>🇬🇧 <i>No courage is there.</i><br/>🇪🇸 <i>No hay coraje.</i></span></td>
            <td data-label="Negation (Akkusativ)"><span>Er hat <strong><span class="der-color">keinen Mut</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>He has no courage.</i><br/>🇪🇸 <i>Él no tiene coraje.</i></span></td>
          </tr>
          <tr>
            <td data-label="Substantiv"><strong><span class="die-color">die Kraft</span></strong> <br/> 💪</td>
            <td data-label="Aussprache Englisch Spanisch">🇩🇪 /kraft/<span class="translation"> <br/> 🇬🇧 <i>Strength / Power</i> <br/> 🇪🇸 <i>Fuerza / Poder</i></span></td>
            <td data-label="Beispielsatz"><span>Ich brauche mehr <strong><span class="die-color">Kraft</span></strong>.</span> <span class="translation"><br/> 🇬🇧 <i>I need more strength.</i> <br/> 🇪🇸 <i>Necesito más fuerza.</i></span></td>
            <td data-label="Beispielsatz"><span>Sie hat viel <strong><span class="die-color">Kraft</span></strong>.</span> <span class="translation"><br/> 🇬🇧 <i>She has much strength.</i> <br/> 🇪🇸 <i>Ella tiene mucha fuerza.</i></span></td>
            <td data-label="Definiter Artikel (Nominativ)"><span><strong><span class="die-color">Die Kraft</span></strong> ist nötig.</span><span class="translation"><br/>🇬🇧 <i>Strength is necessary.</i><br/>🇪🇸 <i>La fuerza es necesaria.</i></span></td>
            <td data-label="Definiter Artikel (Akkusativ)"><span>Ich brauche <strong><span class="die-color">die Kraft</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I need strength.</i><br/>🇪🇸 <i>Necesito fuerza.</i></span></td>
            <td data-label="Indefiniter Artikel (Nominativ)"><span>Das ist <strong><span class="die-color">eine</span></strong> große <strong><span class="die-color">Kraft</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>This is great strength.</i><br/>🇪🇸 <i>Esta es gran fuerza.</i></span></td>
            <td data-label="Indefiniter Artikel (Akkusativ)"><span>Ich habe <strong><span class="die-color">eine</span></strong> große <strong><span class="die-color">Kraft</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I have great strength.</i><br/>🇪🇸 <i>Tengo gran fuerza.</i></span></td>
            <td data-label="Negation (Nominativ)"><span><strong><span class="die-color">Keine Kraft</span></strong> ist da.</span><span class="translation"><br/>🇬🇧 <i>No strength is there.</i><br/>🇪🇸 <i>No hay fuerza.</i></span></td>
            <td data-label="Negation (Akkusativ)"><span>Ich habe <strong><span class="die-color">keine Kraft</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I have no strength.</i><br/>🇪🇸 <i>No tengo fuerza.</i></span></td>
          </tr>
          <tr>
            <td data-label="Substantiv"><strong><span class="die-color">die Schwäche</span></strong> <br/> 😟</td>
            <td data-label="Aussprache Englisch Spanisch">🇩🇪 /SHVE-che/<span class="translation"> <br/> 🇬🇧 <i>Weakness</i> <br/> 🇪🇸 <i>Debilidad</i></span></td>
            <td data-label="Beispielsatz"><span>Das ist meine <strong><span class="die-color">Schwäche</span></strong>.</span> <span class="translation"><br/> 🇬🇧 <i>That is my weakness.</i> <br/> 🇪🇸 <i>Esa es mi debilidad.</i></span></td>
            <td data-label="Beispielsatz"><span>Jeder hat eine <strong><span class="die-color">Schwäche</span></strong>.</span> <span class="translation"><br/> 🇬🇧 <i>Everyone has a weakness.</i> <br/> 🇪🇸 <i>Todos tienen una debilidad.</i></span></td>
            <td data-label="Definiter Artikel (Nominativ)"><span><strong><span class="die-color">Die Schwäche</span></strong> ist menschlich.</span><span class="translation"><br/>🇬🇧 <i>Weakness is human.</i><br/>🇪🇸 <i>La debilidad es humana.</i></span></td>
            <td data-label="Definiter Artikel (Akkusativ)"><span>Ich akzeptiere <strong><span class="die-color">die Schwäche</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I accept weakness.</i><br/>🇪🇸 <i>Acepto la debilidad.</i></span></td>
            <td data-label="Indefiniter Artikel (Nominativ)"><span>Das ist <strong><span class="die-color">eine</span></strong> große <strong><span class="die-color">Schwäche</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>This is great weakness.</i><br/>🇪🇸 <i>Esta es gran debilidad.</i></span></td>
            <td data-label="Indefiniter Artikel (Akkusativ)"><span>Ich habe <strong><span class="die-color">eine</span></strong> große <strong><span class="die-color">Schwäche</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I have great weakness.</i><br/>🇪🇸 <i>Tengo gran debilidad.</i></span></td>
            <td data-label="Negation (Nominativ)"><span><strong><span class="die-color">Keine Schwäche</span></strong> ist da.</span><span class="translation"><br/>🇬🇧 <i>No weakness is there.</i><br/>🇪🇸 <i>No hay debilidad.</i></span></td>
            <td data-label="Negation (Akkusativ)"><span>Ich habe <strong><span class="die-color">keine Schwäche</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I have no weakness.</i><br/>🇪🇸 <i>No tengo debilidad.</i></span></td>
          </tr>
          <tr>
            <td data-label="Substantiv"><strong><span class="die-color">die Wahrheit</span></strong> <br/> ✅</td>
            <td data-label="Aussprache Englisch Spanisch">🇩🇪 /VAR-hait/<span class="translation"> <br/> 🇬🇧 <i>Truth</i> <br/> 🇪🇸 <i>Verdad</i></span></td>
            <td data-label="Beispielsatz"><span>Sag mir <strong><span class="die-color">die Wahrheit</span></strong>.</span> <span class="translation"><br/> 🇬🇧 <i>Tell me the truth.</i> <br/> 🇪🇸 <i>Dime la verdad.</i></span></td>
            <td data-label="Beispielsatz"><span><strong><span class="die-color">Die Wahrheit</span></strong> ist wichtig.</span> <span class="translation"><br/> 🇬🇧 <i>Truth is important.</i> <br/> 🇪🇸 <i>La verdad es importante.</i></span></td>
            <td data-label="Definiter Artikel (Nominativ)"><span><strong><span class="die-color">Die Wahrheit</span></strong> ist wichtig.</span><span class="translation"><br/>🇬🇧 <i>Truth is important.</i><br/>🇪🇸 <i>La verdad es importante.</i></span></td>
            <td data-label="Definiter Artikel (Akkusativ)"><span>Ich sage <strong><span class="die-color">die Wahrheit</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I tell the truth.</i><br/>🇪🇸 <i>Digo la verdad.</i></span></td>
            <td data-label="Indefiniter Artikel (Nominativ)"><span>Das ist <strong><span class="die-color">eine</span></strong> harte <strong><span class="die-color">Wahrheit</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>This is a hard truth.</i><br/>🇪🇸 <i>Esta es una verdad dura.</i></span></td>
            <td data-label="Indefiniter Artikel (Akkusativ)"><span>Ich höre <strong><span class="die-color">eine</span></strong> harte <strong><span class="die-color">Wahrheit</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I hear a hard truth.</i><br/>🇪🇸 <i>Escucho una verdad dura.</i></span></td>
            <td data-label="Negation (Nominativ)"><span><strong><span class="die-color">Keine Wahrheit</span></strong> ist da.</span><span class="translation"><br/>🇬🇧 <i>No truth is there.</i><br/>🇪🇸 <i>No hay verdad.</i></span></td>
            <td data-label="Negation (Akkusativ)"><span>Das ist <strong><span class="die-color">keine Wahrheit</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>That is no truth.</i><br/>🇪🇸 <i>Eso no es verdad.</i></span></td>
          </tr>
          <tr>
            <td data-label="Substantiv"><strong><span class="die-color">die Lüge</span></strong> <br/> ❌</td>
