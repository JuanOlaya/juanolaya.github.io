            <td data-label="Beispielsatz"><span>Ich hasse <strong><span class="die-color">Lügen</span></strong>.</span> <span class="translation"><br/> 🇬🇧 <i>I hate lies.</i> <br/> 🇪🇸 <i>Odio las mentiras.</i></span></td>
            <td data-label="Definiter Artikel (Nominativ)"><span><strong><span class="die-color">Die Lüge</span></strong> ist schlecht.</span><span class="translation"><br/>🇬🇧 <i>A lie is bad.</i><br/>🇪🇸 <i>La mentira es mala.</i></span></td>
            <td data-label="Definiter Artikel (Akkusativ)"><span>Ich hasse <strong><span class="die-color">die Lüge</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I hate lies.</i><br/>🇪🇸 <i>Odio las mentiras.</i></span></td>
            <td data-label="Indefiniter Artikel (Nominativ)"><span>Das ist <strong><span class="die-color">eine</span></strong> große <strong><span class="die-color">Lüge</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>This is a big lie.</i><br/>🇪🇸 <i>Esta es una gran mentira.</i></span></td>
            <td data-label="Indefiniter Artikel (Akkusativ)"><span>Ich höre <strong><span class="die-color">eine</span></strong> große <strong><span class="die-color">Lüge</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I hear a big lie.</i><br/>🇪🇸 <i>Escucho una gran mentira.</i></span></td>
            <td data-label="Negation (Nominativ)"><span><strong><span class="die-color">Keine Lüge</span></strong> ist da.</span><span class="translation"><br/>🇬🇧 <i>No lie is there.</i><br/>🇪🇸 <i>No hay mentira.</i></span></td>
