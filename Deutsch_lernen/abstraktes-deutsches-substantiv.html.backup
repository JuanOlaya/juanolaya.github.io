          <tr>
            <td data-label="Substantiv"><strong><span class="der-color">der Traum</span></strong> <br/> 💭</td>
            <td data-label="Aussprache Englisch Spanisch">🇩🇪 /traum/<span class="translation"> <br/> 🇬🇧 <i>Dream</i> <br/> 🇪🇸 <i>Sueño</i></span></td>
            <td data-label="Beispielsatz"><span>Ich hatte einen schönen <strong><span class="der-color">Traum</span></strong>.</span><span class="translation"> <br/> 🇬🇧 <i>I had a beautiful dream.</i> <br/> 🇪🇸 <i>Tuve un sueño hermoso.</i></span></td>
            <td data-label="Beispielsatz"><span>Mein <strong><span class="der-color">Traum</span></strong> wird wahr.</span><span class="translation"> <br/> 🇬🇧 <i>My dream comes true.</i> <br/> 🇪🇸 <i>Mi sueño se hace realidad.</i></span></td>
            <td data-label="Definiter Artikel (Nominativ)"><span><strong><span class="der-color">Der Traum</span></strong> ist schön.</span><span class="translation"><br/>🇬🇧 <i>The dream is beautiful.</i><br/>🇪🇸 <i>El sueño es hermoso.</i></span></td>
            <td data-label="Definiter Artikel (Akkusativ)"><span>Ich habe <strong><span class="der-color">den Traum</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I have the dream.</i><br/>🇪🇸 <i>Tengo el sueño.</i></span></td>
            <td data-label="Indefiniter Artikel (Nominativ)"><span>Das ist <strong><span class="der-color">ein</span></strong> guter <strong><span class="der-color">Traum</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>This is a good dream.</i><br/>🇪🇸 <i>Este es un buen sueño.</i></span></td>
            <td data-label="Indefiniter Artikel (Akkusativ)"><span>Ich träume <strong><span class="der-color">einen</span></strong> guten <strong><span class="der-color">Traum</span></strong>.</span><span class="translation"><br/>🇬🇧 <i>I dream a good dream.</i><br/>🇪🇸 <i>Sueño un buen sueño.</i></span></td>
